# Neon: conexión pooled para la app y directa para migraciones (npm run db:migrate)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Supabase Auth (solo inicio de sesión)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Agente de WhatsApp (Kapso + Claude), opcional: sin KAPSO_WEBHOOK_SECRET el webhook responde 503 ---
# Secreto con el que Kapso firma el webhook (el mismo que se registra con `kapso whatsapp webhooks new`)
KAPSO_WEBHOOK_SECRET=
# Llave de la API de Kapso (Integrations > API keys) para enviar respuestas
KAPSO_API_KEY=
# Llave de Anthropic para generar las respuestas; ANTHROPIC_MODEL es opcional (por defecto claude-sonnet-5-5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Números a los que SÍ se contesta automáticamente (solo dígitos, separados por coma). Úsalo para pruebas.
WHATSAPP_TEST_NUMBERS=
# Pon "all" solo cuando quieras responder automáticamente a todos los clientes
WHATSAPP_AUTOREPLY=
# Para los avisos de traspaso y llamadas, y el enlace de cotización que comparte el agente
DASHBOARD_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Neon: conexión pooled para la app y directa para migraciones (npm run db:migrate)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Supabase Auth (solo inicio de sesión)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Respuestas de WhatsApp (Kapso), opcional: sin KAPSO_WEBHOOK_SECRET el webhook responde 503 ---
# Secreto con el que Kapso firma el webhook (el mismo que se registra con `kapso whatsapp webhooks new`)
KAPSO_WEBHOOK_SECRET=
# Para el aviso de Telegram cuando un prospecto responde y el enlace a su ficha
DASHBOARD_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

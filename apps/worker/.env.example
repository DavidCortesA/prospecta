REDIS_PASSWORD=
REDIS_URL=
REDISHOST=
REDISPASSWORD=
REDISPORT=
REDISUSER=

# Neon: usa la conexión directa (sin "-pooler" en el host), el worker mantiene su propio pool
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
USER_AGENT=ProspectaBot/0.3 (+contacto@tu-dominio.com)
# Opcional: token de Apify para importar resultados de Google Maps
APIFY_TOKEN=

# --- Primer mensaje automático de WhatsApp (Kapso). Apagado salvo WHATSAPP_OUTREACH=on ---
WHATSAPP_OUTREACH=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Plantilla aprobada por Meta; {{1}}, {{2}}... se llenan con WHATSAPP_TEMPLATE_VARS, en orden
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_TEMPLATE_VARS=empresa,negocio
# Máximo de primeros mensajes por día, por corrida (cada 15 min), horario (lun-sáb) y score mínimo
WHATSAPP_DAILY_LIMIT=20
WHATSAPP_PER_RUN=5
WHATSAPP_SEND_HOURS=9-18
WHATSAPP_MIN_SCORE=0

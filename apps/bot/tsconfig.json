{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Igual que los alias de wrangler.jsonc
    "paths": {
      "pg": ["./src/shims/pg.ts"],
      "dotenv/config": ["./src/shims/empty.ts"]
    }
  },
  "include": ["src"]
}

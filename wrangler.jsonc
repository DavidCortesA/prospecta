{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el nombre del Worker creado en el dashboard de Cloudflare
  "name": "prospecta",
  "main": "apps/bot/src/worker.ts",
  "compatibility_date": "2025-09-01",
  // Necesario para process.env y las utilidades de Node que usa el bot
  "compatibility_flags": ["nodejs_compat"],
  // Los secretos se configuran en el dashboard; que un deploy no borre variables
  "keep_vars": true,
  // El bot de apps/worker usa `pg` (TCP) y dotenv: en el Worker se sustituyen por equivalentes
  "alias": {
    "pg": "./apps/bot/src/shims/pg.ts",
    "dotenv/config": "./apps/bot/src/shims/empty.ts"
  },
  "observability": { "enabled": true }
}
